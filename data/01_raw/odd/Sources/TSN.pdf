   photoshop:Credit="Getty Images"
   photoshop:Headline="Cooking and seasoning backgrounds: vegetables, herbs and spices frame."
   photoshop:URL="https://www.gettyimages.com"
   photoshop:Instructions="Not Released (NR) "
   Iptc4xmpCore:CountryCode="UNS"
   GettyImagesGIFT:Dlref="Ckzyvr7ToU0f89iGAw4gNg=="
