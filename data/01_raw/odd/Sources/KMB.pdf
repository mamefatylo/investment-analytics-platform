   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Small girl laughs happily in a primary school class, she is sitting at a table with her her classmates. Elementary school students enjoying an art and creativity class in a child development centre.</rdf:li>
    </rdf:Alt>
