   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Extreme close up of blue empty plastic bag background. The plastic surface is wrinkly and tattered making abstract pattern. Selective focus, shallow depth of field.</rdf:li>
    </rdf:Alt>
   </dc:description>
